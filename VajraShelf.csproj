<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>VajraShelf</AssemblyName>
    <RootNamespace>VajraShelf</RootNamespace>
    <Title>Vajra Shelf</Title>
    <Product>Vajra Shelf</Product>
    <Company>Vajra Shelf</Company>
    <Description>A private local drag-and-drop shelf for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*" />
  </ItemGroup>
</Project>
