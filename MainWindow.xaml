<Window x:Class="VajraShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VajraShelf.Models"
        Title="Vajra Shelf" Width="354" Height="84"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True"
        SnapsToDevicePixels="True" AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Nothing is painted outside ShellClip; transparent layered-window margins remain alpha zero. -->
    <Canvas x:Name="ShelfCanvas" ClipToBounds="True">
        <Grid x:Name="Shell" Width="720" Height="460" Canvas.Left="-183" Canvas.Top="12"
              MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave" MouseMove="Shell_MouseMove">
            <Grid.RenderTransform><ScaleTransform x:Name="ShellScale"/></Grid.RenderTransform>
            <Grid.Clip><RectangleGeometry x:Name="ShellClip" Rect="195,0,330,60" RadiusX="30" RadiusY="30"/></Grid.Clip>
            <Path x:Name="ShellSurface" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5"/>
            <Border Background="{DynamicResource ShelfHighlightBrush}" IsHitTestVisible="False"/>

            <Grid x:Name="CompactContent" Width="330" Height="60" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CompactButton" Style="{StaticResource ChromeButton}" Click="Compact_Click"
                        HorizontalContentAlignment="Left" Padding="18,0,10,0"
                        AutomationProperties.Name="Expand Vajra Shelf">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="DropDot" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock x:Name="CompactLabel" Text="Drop here" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompactCount" Text="0 items" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B0;" Click="Paste_Click"
                        ToolTip="Add from clipboard · Ctrl+Alt+P" AutomationProperties.Name="Add from clipboard" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70E;" Click="Compact_Click"
                        ToolTip="Open shelf" AutomationProperties.Name="Open shelf" Margin="0,0,12,0"/>
            </Grid>

            <Grid x:Name="ExpandedContent" Width="684" Height="424" Margin="18"
                  Visibility="Hidden" Opacity="0" IsEnabled="False" IsHitTestVisible="False"
                  KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None">
                <Grid.RenderTransform><TranslateTransform x:Name="BodyTranslation" Y="12"/></Grid.RenderTransform>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                        <TextBlock Text="VAJRA SHELF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="0,6">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Search_TextChanged"
                                 AutomationProperties.Name="Search shelf"/>
                        <TextBlock x:Name="SearchHint" Text="Search items" Foreground="{DynamicResource MutedBrush}"
                                   IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="Compact_Click" ToolTip="Collapse shelf" AutomationProperties.Name="Collapse shelf"/>
                        <Button x:Name="PinShelfButton" Style="{StaticResource IconButton}" Content="&#xE718;" Click="PinShelf_Click" ToolTip="Keep shelf expanded" AutomationProperties.Name="Keep shelf expanded"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Clear_Click" ToolTip="Clear temporary items" AutomationProperties.Name="Clear temporary items"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Open settings"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                        <ItemsControl x:Name="ShelfItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemWidth="218" ItemHeight="144"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ShelfItem}">
                                    <Border x:Name="Card" Width="208" Height="134" Margin="5" Padding="12,10"
                                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="15"
                                            PreviewMouseLeftButtonDown="Card_MouseLeftButtonDown"
                                            PreviewMouseMove="Card_MouseMove" Tag="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="17" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="7,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PinnedMark" FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="10" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding AgeLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,8,0,5">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Text="{Binding Preview}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="31" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="PinAction" Style="{StaticResource CardAction}" Content="Pin" Click="ItemPin_Click" Tag="{Binding}" ToolTip="Pin or unpin"/>
                                                    <Button Style="{StaticResource CardAction}" Content="Copy" Click="ItemCopy_Click" Tag="{Binding}" Margin="3,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="OpenAction" Style="{StaticResource CardAction}" Content="Open" Click="ItemOpen_Click" Tag="{Binding}"/>
                                                    <Button x:Name="RevealAction" Style="{StaticResource CardAction}" Content="Show" Click="ItemReveal_Click" Tag="{Binding}" Margin="3,0,0,0"/>
                                                    <Button Style="{StaticResource CardAction}" Content="×" Click="ItemRemove_Click" Tag="{Binding}" Margin="3,0,0,0" ToolTip="Remove"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.52"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter TargetName="PinnedMark" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="PinAction" Property="Content" Value="Unpin"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                            <Setter TargetName="OpenAction" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RevealAction" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Color">
                                            <Setter TargetName="OpenAction" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RevealAction" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Link">
                                            <Setter TargetName="RevealAction" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop files, folders, links or text" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="Nothing leaves this PC." FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FooterCount" Grid.Column="1" Text="0 items" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Border x:Name="DropFeedback" Visibility="Collapsed" IsHitTestVisible="False" Margin="7"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="24"
                    Background="#2215BFA7">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Release to add" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Canvas>
</Window>
